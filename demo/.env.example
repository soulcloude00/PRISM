# Copy to demo/.env — never commit .env (gitignored)
# Get these from: Cartesia dashboard, Databricks workspace > Genie Space ID
CARTESIA_API_KEY=your_cartesia_key_here
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_pat_here
GENIE_SPACE_ID=your_genie_space_id_here
PORT=8001
# For hackathon demo without keys / offline WiFi:
DEMO_MODE=false
